# Keystore de release - configuracao local (NAO versionar)
#
# Copie este arquivo para "keystore.properties" e ajuste os valores.
# O arquivo "keystore.properties" esta no .gitignore.
#
# Para gerar um keystore novo:
#   keytool -genkeypair -v \
#     -keystore release.jks \
#     -alias resume-ai \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Guarde o keystore e a senha em local seguro: perder o keystore impede
# publicar atualizações da mesma aplicacao (o Android exige a mesma chave).

storeFile=release.jks
storePassword=
keyAlias=resume-ai
keyPassword=
